# PostgreSQL connection (copy to .env.local and fill in credentials)
# For Supabase: Project Settings → Database → Connection string (URI, pooler).
# Use transaction pooler (6543) for DATABASE_URL; session pooler (5432) as DIRECT_URL for migrations.
DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true&sslmode=require
DIRECT_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-1-REGION.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase project URL + publishable key (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_publishable_key

# Supabase Postgres (Project Settings → Database → password). Used by: npm run supabase:setup
# Or paste the full pooler URI as DATABASE_URL for the live site.
# SUPABASE_DB_PASSWORD=your_database_password
# DATABASE_URL=postgresql://postgres.PROJECT_REF:PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?sslmode=require

# Optional public URLs
NEXT_PUBLIC_SPOTIFY_SHOW_URL=
NEXT_PUBLIC_SPOTIFY_FOLLOW_URL=
NEXT_PUBLIC_TOP_NEWS_YOUTUBE_URL=
NEXT_PUBLIC_TOP_NEWS_YOUTUBE_TITLE=
NEXT_PUBLIC_TOP_NEWS_CHANNEL_URL=
NEXT_PUBLIC_TOP_NEWS_CHANNEL_LABEL=
NEXT_PUBLIC_GOOGLE_FORM_URL=
NEXT_PUBLIC_GOOGLE_FORM_EMBED_URL=
